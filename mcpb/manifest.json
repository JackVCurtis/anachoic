{
  "manifest_version": "0.3",
  "name": "anachoic",
  "display_name": "Anachoic",
  "version": "0.5.0",
  "description": "A board for planning work as chains of steps shared between you and your Claude sessions.",
  "author": {
    "name": "Jack Curtis"
  },
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/server.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/server.js"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin"
    ],
    "runtimes": {
      "node": ">=24.0.0"
    }
  },
  "prompts": [
    {
      "name": "board",
      "description": "Show the board",
      "text": "Show the Anachoic board."
    },
    {
      "name": "history",
      "description": "Show the history",
      "text": "Show the Anachoic history."
    }
  ]
}
